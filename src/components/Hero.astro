---

---

<section id="hero" aria-label="Presentación">
  <div class="hero-bg-glow" aria-hidden="true"></div>
  <div class="container hero-inner">
    <div class="hero-content">
      <div class="hero-status">
        <span class="glow-dot" aria-hidden="true"></span>
        <span
          class="mono"
          style="font-size:0.72rem;letter-spacing:0.12em;color:var(--text-secondary);"
          >DISPONIBLE PARA TRABAJAR</span
        >
      </div>

      <h1 class="hero-title">
        Hola, soy<br />
        <span class="hero-name">Alejandro<br />Bohorquez</span>
      </h1>

      <p class="hero-role mono">
        <span class="hero-role-prefix" aria-hidden="true">$ </span>Full-Stack
        Developer
        <span class="hero-cursor" aria-hidden="true">_</span>
      </p>

      <p class="hero-desc">
        Construyo aplicaciones web modernas de principio a fin — desde la
        interfaz hasta la infraestructura cloud. Especializado en JavaScript,
        TypeScript, Next.js y NestJS.
      </p>

      <div class="hero-actions">
        <a href="#proyectos" class="btn btn-primary">Ver proyectos</a>
        <a href="#contacto" class="btn btn-outline">Hablemos</a>
      </div>

      <div class="hero-stack" aria-label="Stack principal">
        {
          ["Next.js", "NestJS", "TypeScript", "React", "AWS", "Node.js"].map(
            (t) => <span class="tag">{t}</span>,
          )
        }
      </div>
    </div>

    <div class="hero-visual" aria-hidden="true">
      <div class="hero-code-card">
        <div class="code-header">
          <span class="dot red"></span>
          <span class="dot yellow"></span>
          <span class="dot green"></span>
          <span class="code-filename">developer.ts</span>
        </div>
        <pre
          class="code-body"><code><span class="c-kw">const</span> <span class="c-var">alejandro</span> <span class="c-op">=</span> <span class="c-op">&#123;</span>
  <span class="c-prop">role</span><span class="c-op">:</span> <span class="c-str">'Full-Stack Developer'</span>,
  <span class="c-prop">location</span><span class="c-op">:</span> <span class="c-str">'Colombia 🇨🇴'</span>,
  <span class="c-prop">experience</span><span class="c-op">:</span> <span class="c-num">3</span><span class="c-op">+</span> <span class="c-str">'años'</span>,
  <span class="c-prop">stack</span><span class="c-op">:</span> [
    <span class="c-str">'Next.js'</span>, <span class="c-str">'NestJS'</span>,
    <span class="c-str">'TypeScript'</span>, <span class="c-str">'AWS'</span>
  ],
  <span class="c-prop">openToWork</span><span class="c-op">:</span> <span class="c-kw">true</span> <span class="c-comment">// 👋</span>
<span class="c-op">&#125;</span></code></pre>
      </div>

      <div class="hero-stats">
        <div class="stat">
          <span class="stat-num">3<span class="stat-plus">+</span></span>
          <span class="stat-label">Años de experiencia</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <span class="stat-num">10<span class="stat-plus">+</span></span>
          <span class="stat-label">Proyectos entregados</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <span class="stat-num">2</span>
          <span class="stat-label">Empresas</span>
        </div>
      </div>
    </div>
  </div>

  <div class="hero-scroll-hint" aria-hidden="true">
    <span
      class="mono"
      style="font-size:0.65rem;letter-spacing:0.15em;color:var(--text-muted);"
      >SCROLL</span
    >
    <div class="scroll-line"></div>
  </div>
</section>

<style>
  #hero {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: 70px;
    padding-bottom: 3rem;
    overflow: hidden;
  }

  .hero-bg-glow {
    position: absolute;
    top: -200px;
    left: -200px;
    width: 700px;
    height: 700px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(37, 99, 255, 0.12) 0%,
      transparent 65%
    );
    pointer-events: none;
    animation: float 8s ease-in-out infinite;
  }

  @keyframes float {
    0%,
    100% {
      transform: translate(0, 0);
    }
    33% {
      transform: translate(40px, -30px);
    }
    66% {
      transform: translate(-20px, 20px);
    }
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
    min-height: calc(100svh - 70px - 3rem);
  }

  /* Content */
  .hero-status {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.5rem;
  }

  .hero-title {
    margin-bottom: 1rem;
    color: var(--text-primary);
  }
  .hero-name {
    color: var(--blue-glow);
    display: block;
  }

  .hero-role {
    font-size: 1rem;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
    letter-spacing: 0.05em;
  }
  .hero-role-prefix {
    color: var(--blue-elec);
  }
  .hero-cursor {
    display: inline-block;
    color: var(--blue-glow);
    animation: blink 1.1s step-end infinite;
  }
  @keyframes blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }

  .hero-desc {
    max-width: 460px;
    margin-bottom: 2.5rem;
    font-size: 1.05rem;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 2.5rem;
  }

  .hero-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  /* Visual / Code */
  .hero-visual {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .hero-code-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow:
      0 0 60px rgba(37, 99, 255, 0.1),
      0 30px 60px rgba(0, 0, 0, 0.4);
  }

  .code-header {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.75rem 1rem;
    background: rgba(255, 255, 255, 0.03);
    border-bottom: 1px solid var(--border);
  }
  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }
  .dot.red {
    background: #ff5f57;
  }
  .dot.yellow {
    background: #febc2e;
  }
  .dot.green {
    background: #28c840;
  }
  .code-filename {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
    margin-left: 0.5rem;
  }

  .code-body {
    padding: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    line-height: 1.9;
    overflow-x: auto;
  }
  .c-kw {
    color: #c792ea;
  }
  .c-var {
    color: #82aaff;
  }
  .c-op {
    color: #89ddff;
  }
  .c-prop {
    color: #f07178;
  }
  .c-str {
    color: #c3e88d;
  }
  .c-num {
    color: #f78c6c;
  }
  .c-comment {
    color: #546e7a;
    font-style: italic;
  }

  /* Stats */
  .hero-stats {
    display: flex;
    align-items: center;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.75rem;
  }
  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: 1;
    gap: 0.2rem;
  }
  .stat-num {
    font-family: var(--font-display);
    font-size: 1.8rem;
    font-weight: 800;
    color: var(--text-primary);
    line-height: 1;
  }
  .stat-plus {
    color: var(--blue-glow);
  }
  .stat-label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    text-align: center;
  }
  .stat-divider {
    width: 1px;
    height: 40px;
    background: var(--border);
    flex-shrink: 0;
  }

  /* Scroll hint */
  .hero-scroll-hint {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }
  .scroll-line {
    width: 1px;
    height: 40px;
    background: linear-gradient(to bottom, var(--blue-dim), transparent);
    animation: scroll-drop 1.8s ease-in-out infinite;
  }
  @keyframes scroll-drop {
    0% {
      opacity: 0;
      transform: scaleY(0);
      transform-origin: top;
    }
    50% {
      opacity: 1;
      transform: scaleY(1);
      transform-origin: top;
    }
    100% {
      opacity: 0;
      transform: scaleY(1);
      transform-origin: bottom;
    }
  }

  /* Responsive */
  @media (max-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 3rem;
      padding-top: 2rem;
      padding-bottom: 4rem;
    }
    .hero-visual {
      order: -1;
    }
    .hero-scroll-hint {
      display: none;
    }
  }
</style>
