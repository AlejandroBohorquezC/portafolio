---
const skillGroups = [
  {
    category: 'Frontend',
    icon: '🖥️',
    skills: [
      { name: 'Next.js',         level: 85 },
      { name: 'React.js',        level: 85 },
      { name: 'TypeScript',      level: 80 },
      { name: 'TailwindCSS',     level: 85 },
      { name: 'Styled Components', level: 75 },
      { name: 'Redux Toolkit',   level: 70 },
    ]
  },
  {
    category: 'Backend',
    icon: '⚙️',
    skills: [
      { name: 'NestJS',          level: 80 },
      { name: 'Node.js',         level: 80 },
      { name: 'Laravel / PHP',   level: 55 },
      { name: 'REST APIs',       level: 85 },
      { name: 'WebSockets',      level: 70 },
      { name: 'TypeORM',         level: 70 },
    ]
  },
  {
    category: 'Cloud & Servicios',
    icon: '☁️',
    skills: [
      { name: 'AWS DynamoDB',    level: 75 },
      { name: 'AWS Cognito',     level: 75 },
      { name: 'AWS SES',         level: 70 },
      { name: 'OpenAI API',      level: 75 },
      { name: 'WhatsApp Meta API', level: 75 },
      { name: 'Vercel',          level: 80 },
    ]
  },
  {
    category: 'Bases de datos',
    icon: '🗄️',
    skills: [
      { name: 'PostgreSQL',      level: 75 },
      { name: 'MongoDB',         level: 65 },
      { name: 'MySQL',           level: 65 },
      { name: 'DynamoDB',        level: 75 },
    ]
  },
  {
    category: 'CMS & Herramientas',
    icon: '🛠️',
    skills: [
      { name: 'WordPress / Divi', level: 75 },
      { name: 'Drupal',           level: 65 },
      { name: 'Git / GitHub',     level: 85 },
      { name: 'Figma',            level: 65 },
      { name: 'Jira / Scrum',     level: 75 },
      { name: 'Docker (básico)',   level: 45 },
    ]
  },
];

const certs = [
  { title: 'Unit, Integration & E2E Testing (FullStack JS)', year: '2023' },
  { title: 'Principios SOLID y Clean Code', year: '2023' },
  { title: 'TypeScript Guía Completa', year: '2023' },
  { title: 'React: De Cero a Experto', year: '2023' },
  { title: 'Git y Github', year: '2023' },
  { title: 'Node: De Cero a Experto', year: '2022' },
  { title: 'JavaScript Moderno', year: '2022' },
  { title: 'CSS Completo: Flexbox, Grid, SASS', year: '2022' },
];
---

<section id="skills" aria-labelledby="skills-heading">
  <div class="container">
    <div class="section-title reveal">
      <div class="section-label">Habilidades</div>
      <h2 id="skills-heading">Mi <span>stack técnico</span></h2>
    </div>

    <div class="skills-grid">
      {skillGroups.map((group, gi) => (
        <div class="skill-group card reveal" style={`transition-delay:${gi * 0.08}s`}>
          <div class="skill-group-header">
            <span class="skill-icon" aria-hidden="true">{group.icon}</span>
            <h3>{group.category}</h3>
          </div>
          <ul class="skill-list" role="list">
            {group.skills.map(skill => (
              <li class="skill-item">
                <div class="skill-meta">
                  <span class="skill-name">{skill.name}</span>
                  <span class="skill-pct mono">{skill.level}%</span>
                </div>
                <div class="skill-bar" role="progressbar" aria-valuenow={skill.level} aria-valuemin={0} aria-valuemax={100} aria-label={`${skill.name}: ${skill.level}%`}>
                  <div class="skill-fill" style={`--target: ${skill.level}%`}></div>
                </div>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Certifications -->
    <div class="certs-section reveal">
      <div class="section-label" style="margin-top:4rem">Certificaciones</div>
      <div class="certs-grid">
        {certs.map((c, i) => (
          <div class="cert-card" style={`animation-delay:${i * 0.05}s`}>
            <span class="cert-badge mono">{c.year}</span>
            <span class="cert-title">{c.title}</span>
            <span class="cert-platform mono">Udemy</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
.skills-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: 1.25rem;
}

.skill-group-header {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  margin-bottom: 1.5rem;
  padding-bottom: 0.75rem;
  border-bottom: 1px solid var(--border);
}

.skill-icon { font-size: 1.2rem; }

.skill-group h3 {
  font-size: 0.95rem;
  color: var(--text-primary);
}

.skill-list {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 0.85rem;
}

.skill-meta {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 0.35rem;
}

.skill-name {
  font-family: var(--font-display);
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--text-secondary);
}

.skill-pct {
  font-size: 0.65rem;
  color: var(--text-muted);
  letter-spacing: 0.05em;
}

.skill-bar {
  height: 4px;
  background: rgba(255,255,255,0.05);
  border-radius: 2px;
  overflow: hidden;
}

.skill-fill {
  height: 100%;
  width: 0;
  background: linear-gradient(90deg, var(--blue-dim), var(--blue-glow));
  border-radius: 2px;
  transition: width 1.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.skill-group.visible .skill-fill {
  width: var(--target);
}

/* Certs */
.certs-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  gap: 0.75rem;
  margin-top: 1.25rem;
}

.cert-card {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.85rem 1rem;
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  transition: var(--transition);
}
.cert-card:hover {
  border-color: var(--border-bright);
  background: var(--bg-card-hover);
}

.cert-badge {
  font-size: 0.65rem;
  color: var(--blue-glow);
  letter-spacing: 0.06em;
  flex-shrink: 0;
  background: rgba(37,99,255,0.1);
  padding: 0.15rem 0.4rem;
  border-radius: 3px;
  border: 1px solid rgba(37,99,255,0.2);
}

.cert-title {
  font-family: var(--font-display);
  font-size: 0.8rem;
  font-weight: 600;
  color: var(--text-secondary);
  flex: 1;
  line-height: 1.3;
}

.cert-platform {
  font-size: 0.62rem;
  color: var(--text-muted);
  flex-shrink: 0;
}
</style>
