---
const experiences = [
  {
    company: 'WhiteLabel AI',
    role: 'Full-Stack Developer',
    period: 'Sep 2024 – Nov 2025',
    type: 'Tiempo completo',
    bullets: [
      'Arquitectura Full-Stack completa con NestJS y Next.js para plataforma B2B de pagos y comunicaciones.',
      'Integración con API de WhatsApp de Meta: captura de mensajes, respuestas con IA y automatización de campañas de marketing.',
      'Autenticación y autorización segura con AWS Cognito; almacenamiento crítico en AWS DynamoDB.',
      'Sistema de chat en tiempo real con Pusher/WebSockets + agente IA con OpenAI API.',
      'Envío de correos transaccionales con AWS SES; despliegue continuo en Vercel.',
    ],
    stack: ['Next.js', 'NestJS', 'TypeScript', 'AWS', 'Pusher', 'DynamoDB', 'PostgreSQL'],
    current: false,
  },
  {
    company: 'The Pursuit of Value',
    role: 'Front-end Developer',
    period: 'Abr 2022 – Oct 2022',
    type: 'Tiempo completo',
    bullets: [
      'Frontend de gestor documental ejecutando diseño en Figma con Next.js y TypeScript.',
      'Funcionalidad de drag & drop para carga de documentos y previsualizador de archivos.',
      'Gestión de estado global con Redux Toolkit; diseño modular con Atomic Design y Styled Components.',
    ],
    stack: ['Next.js', 'TypeScript', 'Redux Toolkit', 'Styled Components'],
    current: false,
  },
];

const freelance = [
  { company: 'Escuela Judicial Rodrigo Lara Bonilla', role: 'CMS Developer — Drupal',   period: 'Mar – Abr 2026' },
  { company: 'WhiteLabel AI (subcontrato)',            role: 'WordPress Developer',        period: 'Sep – Oct 2025' },
  { company: 'Cliente independiente',                  role: 'Full-Stack Dev — Laravel + Next.js', period: 'May – Jun 2025' },
  { company: 'Codling / Organic Nails',               role: 'Webmaster — E-commerce',    period: 'Ene – Feb 2023' },
];
---

<section id="experiencia" aria-labelledby="exp-heading">
  <div class="container">
    <div class="section-title reveal">
      <div class="section-label">Experiencia</div>
      <h2 id="exp-heading">Mi <span>trayectoria</span></h2>
    </div>

    <!-- Main jobs -->
    <div class="timeline">
      {experiences.map((exp, i) => (
        <article class="timeline-item reveal" style={`transition-delay:${i * 0.12}s`}>
          <div class="timeline-line" aria-hidden="true">
            <div class="timeline-dot"></div>
          </div>

          <div class="timeline-content card">
            <div class="exp-header">
              <div>
                <div class="exp-company">{exp.company}</div>
                <h3 class="exp-role">{exp.role}</h3>
              </div>
              <div class="exp-right">
                <span class="exp-period mono">{exp.period}</span>
                <span class="tag">{exp.type}</span>
              </div>
            </div>

            <ul class="exp-bullets" role="list">
              {exp.bullets.map(b => (
                <li class="exp-bullet">
                  <span class="bullet-dot" aria-hidden="true"></span>
                  {b}
                </li>
              ))}
            </ul>

            <div class="exp-stack">
              {exp.stack.map(t => <span class="tag">{t}</span>)}
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Freelance table -->
    <div class="freelance-section reveal">
      <div class="section-label" style="margin-top:3.5rem;margin-bottom:1.25rem">Consultoría independiente</div>
      <div class="freelance-grid">
        {freelance.map((f, i) => (
          <div class="freelance-row" style={`animation-delay:${i * 0.06}s`}>
            <div class="fl-period mono">{f.period}</div>
            <div class="fl-company">{f.company}</div>
            <div class="fl-role">{f.role}</div>
            <div class="fl-dot" aria-hidden="true"></div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<style>
/* Timeline */
.timeline {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
  position: relative;
}

.timeline-item {
  display: grid;
  grid-template-columns: 40px 1fr;
  gap: 1rem;
}

.timeline-line {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 1.75rem;
}

.timeline-dot {
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background: var(--blue-elec);
  box-shadow: 0 0 12px var(--blue-glow);
  flex-shrink: 0;
  position: relative;
  z-index: 1;
}

.timeline-line::after {
  content: '';
  flex: 1;
  width: 1px;
  background: linear-gradient(to bottom, var(--blue-dim), transparent);
  margin-top: 0.5rem;
}

.timeline-item:last-child .timeline-line::after { display: none; }

/* Content */
.exp-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 1rem;
  margin-bottom: 1.25rem;
  flex-wrap: wrap;
}

.exp-company {
  font-family: var(--font-mono);
  font-size: 0.72rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--blue-glow);
  margin-bottom: 0.3rem;
}

.exp-role {
  font-size: 1.15rem;
  color: var(--text-primary);
}

.exp-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 0.4rem;
  flex-shrink: 0;
}

.exp-period {
  font-size: 0.72rem;
  color: var(--text-muted);
  letter-spacing: 0.06em;
}

.exp-bullets {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
  margin-bottom: 1.25rem;
}

.exp-bullet {
  display: flex;
  gap: 0.75rem;
  font-size: 0.9rem;
  color: var(--text-secondary);
  line-height: 1.6;
}

.bullet-dot {
  flex-shrink: 0;
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: var(--blue-dim);
  margin-top: 0.55rem;
}

.exp-stack {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
  padding-top: 1rem;
  border-top: 1px solid var(--border);
}

/* Freelance grid */
.freelance-grid {
  display: flex;
  flex-direction: column;
  gap: 0;
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  overflow: hidden;
}

.freelance-row {
  display: grid;
  grid-template-columns: 150px 1fr 1fr 8px;
  align-items: center;
  gap: 1rem;
  padding: 1rem 1.25rem;
  border-bottom: 1px solid var(--border);
  transition: var(--transition);
}
.freelance-row:last-child { border-bottom: none; }
.freelance-row:hover { background: var(--bg-card-hover); }

.fl-period {
  font-size: 0.7rem;
  color: var(--text-muted);
  letter-spacing: 0.05em;
}

.fl-company {
  font-family: var(--font-display);
  font-weight: 700;
  font-size: 0.88rem;
  color: var(--text-primary);
}

.fl-role {
  font-size: 0.82rem;
  color: var(--text-secondary);
}

.fl-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--blue-dim);
}

@media (max-width: 700px) {
  .timeline-item { grid-template-columns: 24px 1fr; }
  .exp-header { flex-direction: column; }
  .exp-right { align-items: flex-start; }
  .freelance-row { grid-template-columns: 1fr; gap: 0.25rem; }
  .fl-dot { display: none; }
}
</style>
