---
// Reemplaza YOUR_FORM_ID con tu ID de Formspree: https://formspree.io
const FORMSPREE_ID = import.meta.env.PUBLIC_FORMSPREE_ID;
---

<section id="contacto" aria-labelledby="contacto-heading">
  <div class="container">
    <div class="contact-grid">
      <div class="contact-left reveal">
        <div class="section-label">Contacto</div>
        <h2 id="contacto-heading">¿Hablamos? <span>🚀</span></h2>
        <p class="contact-intro">
          Estoy buscando mi próximo reto. Si tienes un proyecto interesante, una
          vacante que encaje o simplemente quieres conectar, escríbeme —
          respondo en menos de 24 horas.
        </p>

        <div class="contact-channels">
          <a
            href="mailto:fabohorquezcn@gmail.com"
            class="channel-card card"
            aria-label="Enviar email"
          >
            <div class="channel-icon" aria-hidden="true">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <rect x="2" y="4" width="20" height="16" rx="2"></rect><path
                  d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
              </svg>
            </div>
            <div>
              <div class="channel-label mono">Email</div>
              <div class="channel-value">fabohorquezcn@gmail.com</div>
            </div>
          </a>

          <a
            href="https://www.linkedin.com/in/alejandro-bohorquez-/"
            target="_blank"
            rel="noopener noreferrer"
            class="channel-card card"
            aria-label="LinkedIn"
          >
            <div class="channel-icon" aria-hidden="true">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path
                  d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
                ></path>
              </svg>
            </div>
            <div>
              <div class="channel-label mono">LinkedIn</div>
              <div class="channel-value">alejandro-bohorquez-</div>
            </div>
          </a>

          <a
            href="https://github.com/AlejandroBohorquezC"
            target="_blank"
            rel="noopener noreferrer"
            class="channel-card card"
            aria-label="GitHub"
          >
            <div class="channel-icon" aria-hidden="true">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path
                  d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12Z"
                ></path>
              </svg>
            </div>
            <div>
              <div class="channel-label mono">GitHub</div>
              <div class="channel-value">AlejandroBohorquezC</div>
            </div>
          </a>
        </div>
      </div>

      <div class="contact-right reveal" style="transition-delay:0.15s">
        <form
          id="contact-form"
          action={`https://formspree.io/f/${FORMSPREE_ID}`}
          method="POST"
          class="contact-form card"
          novalidate
        >
          <div class="form-row">
            <div class="form-group">
              <label for="name" class="form-label mono">Nombre *</label>
              <input
                id="name"
                type="text"
                name="name"
                class="form-input"
                placeholder="Tu nombre"
                required
                autocomplete="name"
              />
            </div>
            <div class="form-group">
              <label for="email" class="form-label mono">Email *</label>
              <input
                id="email"
                type="email"
                name="email"
                class="form-input"
                placeholder="tu@email.com"
                required
                autocomplete="email"
              />
            </div>
          </div>

          <div class="form-group">
            <label for="subject" class="form-label mono">Asunto *</label>
            <input
              id="subject"
              type="text"
              name="subject"
              class="form-input"
              placeholder="¿De qué se trata?"
              required
            />
          </div>

          <div class="form-group">
            <label for="message" class="form-label mono">Mensaje *</label>
            <textarea
              id="message"
              name="message"
              class="form-input form-textarea"
              placeholder="Cuéntame sobre el proyecto o la oportunidad..."
              rows="5"
              required></textarea>
          </div>

          <button
            type="submit"
            class="btn btn-primary form-submit"
            id="submit-btn"
          >
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              aria-hidden="true"
            >
              <line x1="22" y1="2" x2="11" y2="13"></line>
              <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
            </svg>
            Enviar mensaje
          </button>

          <div
            id="form-success"
            class="form-feedback success"
            role="alert"
            aria-live="polite"
            hidden
          >
            ✅ ¡Mensaje enviado! Te respondo pronto.
          </div>
          <div
            id="form-error"
            class="form-feedback error"
            role="alert"
            aria-live="polite"
            hidden
          >
            ❌ Algo salió mal. Intenta de nuevo o escríbeme directo al email.
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 4rem;
    align-items: start;
  }

  .contact-intro {
    max-width: 400px;
    margin-bottom: 2rem;
    font-size: 1.05rem;
  }

  .contact-channels {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .channel-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    text-decoration: none;
    color: inherit;
  }

  .channel-icon {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-sm);
    background: rgba(37, 99, 255, 0.1);
    border: 1px solid rgba(37, 99, 255, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--blue-glow);
    flex-shrink: 0;
    transition: var(--transition);
  }
  .channel-card:hover .channel-icon {
    background: rgba(37, 99, 255, 0.2);
    box-shadow: 0 0 20px rgba(37, 99, 255, 0.2);
  }

  .channel-label {
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--blue-glow);
    margin-bottom: 0.2rem;
  }

  .channel-value {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  /* Form */
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .form-label {
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--blue-glow);
  }

  .form-input {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 0.7rem 0.9rem;
    font-family: var(--font-display);
    font-size: 0.9rem;
    color: var(--text-primary);
    outline: none;
    transition: var(--transition);
    width: 100%;
  }
  .form-input::placeholder {
    color: var(--text-muted);
  }
  .form-input:focus {
    border-color: var(--blue-elec);
    box-shadow: 0 0 0 3px rgba(37, 99, 255, 0.15);
  }

  .form-textarea {
    resize: vertical;
    min-height: 120px;
  }

  .form-submit {
    width: 100%;
    justify-content: center;
  }

  .form-feedback {
    padding: 0.75rem 1rem;
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    text-align: center;
  }
  .form-feedback.success {
    background: rgba(34, 197, 94, 0.1);
    border: 1px solid rgba(34, 197, 94, 0.3);
    color: #4ade80;
  }
  .form-feedback.error {
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.3);
    color: #f87171;
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }
  @media (max-width: 480px) {
    .form-row {
      grid-template-columns: 1fr;
    }
  }

  /* FORCE INTERACTION */
  .card:before {
    pointer-events: none;
  }
</style>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement;
  const btn = document.getElementById("submit-btn") as HTMLButtonElement;
  const ok = document.getElementById("form-success") as HTMLElement;
  const err = document.getElementById("form-error") as HTMLElement;

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    btn.disabled = true;
    btn.textContent = "Enviando…";
    ok.hidden = true;
    err.hidden = true;

    try {
      const res = await fetch(form.action, {
        method: "POST",
        body: new FormData(form),
        headers: { Accept: "application/json" },
      });

      if (res.ok) {
        ok.hidden = false;
        form.reset();
      } else {
        err.hidden = false;
      }
    } catch {
      err.hidden = false;
    } finally {
      btn.disabled = false;
      btn.innerHTML = `
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <line x1="22" y1="2" x2="11" y2="13"/>
          <polygon points="22 2 15 22 11 13 2 9 22 2"/>
        </svg>
        Enviar mensaje`;
    }
  });
</script>
